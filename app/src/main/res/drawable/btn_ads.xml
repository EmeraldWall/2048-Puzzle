<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><layer-list xmlns:android="http://schemas.android.com/apk/res/android">
<item android:top="6dp">
            <shape android:shape="rectangle">
                <solid android:color="#D49A00" />
                <corners android:radius="22dp" />
            </shape>
        </item>
<item android:top="6dp" android:bottom="1dp">
            <shape android:shape="rectangle">
                <gradient android:angle="270" android:startColor="#FFEE7A" android:endColor="#FFCF2E" />
                <corners android:radius="22dp" />
            </shape>
        </item>
</layer-list></item>
    <item><layer-list xmlns:android="http://schemas.android.com/apk/res/android">
<item android:top="6dp">
            <shape android:shape="rectangle">
                <solid android:color="#D49A00" />
                <corners android:radius="22dp" />
            </shape>
        </item>
<item android:top="0dp" android:bottom="7dp">
            <shape android:shape="rectangle">
                <gradient android:angle="270" android:startColor="#FFEE7A" android:endColor="#FFCF2E" />
                <corners android:radius="22dp" />
            </shape>
        </item>
</layer-list></item>
</selector>
