<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Puzzle2048.App.Controls"
             x:Class="Puzzle2048.App.Pages.MenuPage"
             NavigationPage.HasNavigationBar="False"
             SafeAreaEdges="Container"
             BackgroundColor="#A5E1FF">

    <Grid RowDefinitions="*,Auto">
        <!-- Animated candy backdrop, drawn by the same code as the game screen -->
        <GraphicsView x:Name="BackdropView" InputTransparent="True" />

        <ScrollView>
            <VerticalStackLayout Padding="16,14,16,16" Spacing="12">

                <!-- Level -->
                <Border BackgroundColor="#40FFFFFF" StrokeThickness="0" Padding="16,10,16,12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="6">
                        <Label x:Name="LevelLabel" FontFamily="FredokaBold" FontSize="22" TextColor="White" />
                        <Grid x:Name="LevelTrack" HeightRequest="14">
                            <Border BackgroundColor="#66FFFFFF" StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="7" />
                                </Border.StrokeShape>
                            </Border>
                            <Border x:Name="LevelFill" StrokeThickness="0" HorizontalOptions="Start" WidthRequest="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="7" />
                                </Border.StrokeShape>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Color="#FFD93D" Offset="0" />
                                        <GradientStop Color="#FF6B6B" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <Label x:Name="LevelSubLabel" FontFamily="FredokaBold" FontSize="13" TextColor="White" />
                    </VerticalStackLayout>
                </Border>

                <Image Source="logo.png" HeightRequest="100" Aspect="AspectFit" />

                <Label Text="Slide, merge and win!" HorizontalOptions="Center"
                       FontFamily="FredokaBold" FontSize="19" TextColor="White" />

                <!-- Daily challenge -->
                <c:CandyButton Margin="0,6,0,0" MinimumHeightRequest="118" CornerRadius="26" LipHeight="8"
                               FaceTop="#FFB04D" FaceBottom="#FF6B6B" LipColor="#C93A4A" Clicked="OnDailyClicked">
                    <VerticalStackLayout Padding="14,12" Spacing="2" VerticalOptions="Center">
                        <Label x:Name="DailyTitle" HorizontalOptions="Center" FontFamily="FredokaBold" FontSize="25" TextColor="White" />
                        <Label x:Name="DailyGoalLabel" HorizontalOptions="Center" HorizontalTextAlignment="Center" FontFamily="FredokaBold" FontSize="17" TextColor="White" />
                        <Label x:Name="DailyStatus" HorizontalOptions="Center" HorizontalTextAlignment="Center" FontFamily="FredokaBold" FontSize="15" TextColor="#FFF3D6" />
                        <Label x:Name="DailyStreak" HorizontalOptions="Center" FontFamily="FredokaBold" FontSize="15" TextColor="#FFF3D6" />
                        <Label x:Name="DailyStars" HorizontalOptions="Center" FontSize="24" TextColor="#FFE45C" />
                    </VerticalStackLayout>
                </c:CandyButton>

                <!-- Other modes -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <c:CandyButton MinimumHeightRequest="100" CornerRadius="22" LipHeight="7"
                                   FaceTop="#57E0D0" FaceBottom="#17B8C9" LipColor="#0C8795" Clicked="OnTimeAttackClicked">
                        <VerticalStackLayout Padding="10" Spacing="1" VerticalOptions="Center">
                            <Label Text="Time Attack" HorizontalOptions="Center" FontFamily="FredokaBold" FontSize="21" TextColor="White" />
                            <Label Text="60 seconds" HorizontalOptions="Center" FontFamily="FredokaBold" FontSize="15" TextColor="White" />
                            <Label x:Name="TimeAttackBest" HorizontalOptions="Center" FontFamily="FredokaBold" FontSize="15" TextColor="#E6FFFB" />
                        </VerticalStackLayout>
                    </c:CandyButton>
                    <c:CandyButton Grid.Column="1" MinimumHeightRequest="100" CornerRadius="22" LipHeight="7"
                                   FaceTop="#8DE86A" FaceBottom="#43C455" LipColor="#2A912F" Clicked="OnSprintClicked">
                        <VerticalStackLayout Padding="10" Spacing="1" VerticalOptions="Center">
                            <Label Text="Sprint" HorizontalOptions="Center" FontFamily="FredokaBold" FontSize="21" TextColor="White" />
                            <Label Text="Reach 512 fast" HorizontalOptions="Center" FontFamily="FredokaBold" FontSize="15" TextColor="White" />
                            <Label x:Name="SprintBest" HorizontalOptions="Center" FontFamily="FredokaBold" FontSize="15" TextColor="#F0FFE6" />
                        </VerticalStackLayout>
                    </c:CandyButton>
                </Grid>

                <!-- Classic -->
                <Label Text="CLASSIC" Margin="0,10,0,0" HorizontalOptions="Center"
                       FontFamily="FredokaBold" FontSize="19" TextColor="White" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <c:CandyButton HeightRequest="88" CornerRadius="22" LipHeight="7" Text="4x4" FontSize="30"
                                   FaceTop="#FF8CC4" FaceBottom="#FF4F9A" LipColor="#C42872" Clicked="OnClassic4Clicked" />
                    <c:CandyButton Grid.Column="1" HeightRequest="88" CornerRadius="22" LipHeight="7" Text="5x5" FontSize="30"
                                   FaceTop="#BE94FF" FaceBottom="#8F5CF2" LipColor="#6034C2" Clicked="OnClassic5Clicked" />
                    <c:CandyButton Grid.Column="2" HeightRequest="88" CornerRadius="22" LipHeight="7" Text="6x6" FontSize="30"
                                   FaceTop="#7FCBFF" FaceBottom="#3E9CFF" LipColor="#1F6FCC" Clicked="OnClassic6Clicked" />
                </Grid>

                <c:CandyButton x:Name="RemoveAdsButton" Margin="0,6,0,0" HeightRequest="62" WidthRequest="260" HorizontalOptions="Center"
                               CornerRadius="22" LipHeight="7" FontSize="20" TextColor="#7A4A00" Text="Remove ads"
                               FaceTop="#FFEE7A" FaceBottom="#FFCF2E" LipColor="#D49A00" Clicked="OnRemoveAdsClicked" />

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="16" Margin="0,10,0,0">
                    <c:CandyButton WidthRequest="60" HeightRequest="64" CornerRadius="30" LipHeight="6"
                                   FaceTop="#FFB04D" FaceBottom="#FF8A3D" LipColor="#C8581A" Clicked="OnSettingsClicked" SemanticProperties.Description="Settings">
                        <Image Source="ic_settings.png" WidthRequest="30" HeightRequest="30" />
                    </c:CandyButton>
                    <c:CandyButton WidthRequest="60" HeightRequest="64" CornerRadius="30" LipHeight="6"
                                   FaceTop="#8DE86A" FaceBottom="#43C455" LipColor="#2A912F" Clicked="OnContactClicked" SemanticProperties.Description="Contact us">
                        <Image Source="ic_email.png" WidthRequest="30" HeightRequest="30" />
                    </c:CandyButton>
                    <c:CandyButton WidthRequest="60" HeightRequest="64" CornerRadius="30" LipHeight="6"
                                   FaceTop="#FF8CC4" FaceBottom="#FF4F9A" LipColor="#C42872" Clicked="OnRateClicked" SemanticProperties.Description="Rate the game">
                        <Image Source="ic_rate.png" WidthRequest="30" HeightRequest="30" />
                    </c:CandyButton>
                    <c:CandyButton WidthRequest="60" HeightRequest="64" CornerRadius="30" LipHeight="6"
                                   FaceTop="#7FCBFF" FaceBottom="#3E9CFF" LipColor="#1F6FCC" Clicked="OnShareClicked" SemanticProperties.Description="Share the game">
                        <Image Source="ic_share.png" WidthRequest="30" HeightRequest="30" />
                    </c:CandyButton>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Permanent banner slot, hidden after "Remove ads" -->
        <c:AdBanner x:Name="Ad" Grid.Row="1" HeightRequest="60" />
    </Grid>
</ContentPage>
