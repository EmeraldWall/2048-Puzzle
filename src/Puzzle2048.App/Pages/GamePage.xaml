<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Puzzle2048.App.Controls"
             x:Class="Puzzle2048.App.Pages.GamePage"
             NavigationPage.HasNavigationBar="False"
             SafeAreaEdges="Container">

    <!-- The whole game screen is drawn by GameScene; only the ad is a separate view -->
    <Grid RowDefinitions="*,Auto">
        <GraphicsView x:Name="SceneView" SemanticProperties.Description="2048 game board. Swipe to move the tiles.">
            <GraphicsView.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnPan" />
                <TapGestureRecognizer Tapped="OnTapped" />
            </GraphicsView.GestureRecognizers>
        </GraphicsView>

        <!-- Permanent banner slot, hidden after "Remove ads" -->
        <c:AdBanner x:Name="Ad" Grid.Row="1" HeightRequest="60" />
    </Grid>
</ContentPage>
